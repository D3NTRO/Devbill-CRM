# =============================================================================
# DevBill - Variables de Entorno
# =============================================================================
# Copiar a backend/.env para desarrollo:
#   cp .env.example backend/.env
#
# Para producción, NUNCA usar estos valores por defecto. Generar SECRET_KEY
# fuerte y ajustar DB, CORS, ALLOWED_HOSTS, etc.
# =============================================================================

# --- Django ---------------------------------------------------------------
SECRET_KEY=django-insecure-change-me
# Producción: generar con `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`
# y NUNCA commitearla.

DEBUG=True
# Producción: DEBUG=False (se setea automáticamente con config.settings.prod)

ALLOWED_HOSTS=localhost,127.0.0.1
# Producción: dominio real, ej: .mydomain.com,api.mydomain.com

CSRF_TRUSTED_ORIGINS=
# Producción: https://mydomain.com,https://app.mydomain.com

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Producción: https://app.mydomain.com,https://mydomain.com

FRONTEND_URL=http://localhost:5173
# Producción: https://app.mydomain.com

# --- Base de datos --------------------------------------------------------
DB_NAME=devbill
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
